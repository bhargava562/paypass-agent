# PayPal Sandbox Orders v2 (falls back to simulated Sandbox if unset or placeholder)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_SANDBOX_BUYER_EMAIL=your_fake_buyer@personal.example.com
PAYPAL_SANDBOX_SELLER_EMAIL=your_fake_seller@business.example.com

# Google Gemini Two-Brain Agents (falls back to deterministic engine if unset or rate-limited)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Cryptographic Mandate Signing (HMAC-SHA256)
GHOSTPASS_HMAC_SECRET=replace_with_random_32_byte_secret

# Optional: Neon PostgreSQL HTTP SQL persistence (defaults to In-Memory + localStorage if empty)
DATABASE_URL=

# Optional: Channel3 external catalog enrichment
CHANNEL3_API_KEY=
